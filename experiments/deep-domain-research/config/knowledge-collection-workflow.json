              "manifest_attachment_id": {"type": "string", "minLength": 1},
              "formats": {
                "type": "object",
                "required": ["txt", "json", "html", "pdf", "docx", "xlsx"],
                "additionalProperties": false,
                "properties": {
                  "txt": {
                    "type": "object",
                    "required": ["status", "attachment_id", "filename", "size_bytes", "sha256"],
                    "properties": {
                      "status": {"const": "ready"},
                      "attachment_id": {"type": "string", "minLength": 1},
                      "filename": {"type": "string", "minLength": 1},
                      "size_bytes": {"type": "integer", "minimum": 1},
                      "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                    }
                  },
                  "json": {
                    "type": "object",
                    "required": ["status", "attachment_id", "filename", "size_bytes", "sha256"],
                    "properties": {
                      "status": {"const": "ready"},
                      "attachment_id": {"type": "string", "minLength": 1},
                      "filename": {"type": "string", "minLength": 1},
                      "size_bytes": {"type": "integer", "minimum": 1},
                      "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                    }
                  },
                  "html": {
                    "type": "object",
                    "required": ["status", "attachment_id", "filename", "size_bytes", "sha256"],
                    "properties": {
                      "status": {"const": "ready"},
                      "attachment_id": {"type": "string", "minLength": 1},
                      "filename": {"type": "string", "minLength": 1},
                      "size_bytes": {"type": "integer", "minimum": 1},
                      "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                    }
                  },
                  "pdf": {
                    "type": "object",
                    "required": ["status", "attachment_id", "filename", "size_bytes", "sha256"],
                    "properties": {
                      "status": {"const": "ready"},
                      "attachment_id": {"type": "string", "minLength": 1},
                      "filename": {"type": "string", "minLength": 1},
                      "size_bytes": {"type": "integer", "minimum": 1},
                      "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                    }
                  },
                  "docx": {
                    "type": "object",
                    "required": ["status", "attachment_id", "filename", "size_bytes", "sha256"],
                    "properties": {
                      "status": {"const": "ready"},
                      "attachment_id": {"type": "string", "minLength": 1},
                      "filename": {"type": "string", "minLength": 1},
                      "size_bytes": {"type": "integer", "minimum": 1},
                      "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                    }
                  },
                  "xlsx": {
                    "type": "object",
                    "required": ["status", "attachment_id", "filename", "size_bytes", "sha256"],
                    "properties": {
                      "status": {"const": "ready"},
                      "attachment_id": {"type": "string", "minLength": 1},
                      "filename": {"type": "string", "minLength": 1},
                      "size_bytes": {"type": "integer", "minimum": 1},
                      "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                    }
                  }
                }
              },
              "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "collection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "source_artifacts": {
                "type": "array",
                "minItems": 2,
                "items": {"type": "object", "required": ["sha256"], "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
              }
            }
          }
        },
        {"kind": "value_relation", "key": "report_result.collection_sha256", "other_key": "collection_result.collection.sha256", "operator": "equals"},
        {"kind": "value_relation", "key": "report_result.ontology_sha256", "other_key": "collection_result.inspection.input_checksums.ontology_sha256", "operator": "equals"},
        {"kind": "value_relation", "key": "report_result.fact_graph_sha256", "other_key": "analysis_result.fact_graph.sha256", "operator": "equals"},
        {
          "kind": "id_set_equals",
          "key": "report_result.source_artifacts",
          "id_field": "sha256",
          "other_key": "analysis_result.query_results",
          "other_id_field": "sha256"
        }
      ]
    },
    {"id": "publish_report", "type": "deploy", "label": "Публикация HTML-отчёта", "phase_label": "deployment", "html_from": "report_result.formats.html.attachment_id"},
    {"id": "end", "type": "end"}
